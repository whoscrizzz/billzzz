{
  "name": "bills-pwa",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:api:reset": "bash scripts/dev-api-reset.sh",
    "dev:full": "npm run build && node scripts/dev-api.mjs",
    "build": "npm run cf-typegen && tsc -b && vite build && node scripts/check-sw.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:safe": "npm run validate && npm run build && wrangler d1 migrations apply bills-pwa-db --remote && wrangler deploy && npm run postdeploy:smoke",
    "db:create": "wrangler d1 create bills-pwa-db",
    "db:migrate:local": "wrangler d1 migrations apply bills-pwa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bills-pwa-db --remote",
    "lint": "oxlint",
    "test": "node --test scripts/test-stats.mjs scripts/test-import.mjs scripts/test-notifications.mjs scripts/test-webauthn-config.mjs scripts/test-session-revocation.mjs scripts/test-session-revoke-one.mjs",
    "typecheck": "npm run cf-typegen && tsc -b && tsc -p worker/tsconfig.json --noEmit",
    "cf-typegen": "wrangler types --strict-vars=false",
    "validate": "npm run typecheck && npm run lint && npm test",
    "cf:preflight": "bash scripts/cf-preflight.sh",
    "postdeploy:smoke": "bash scripts/post-deploy-smoke.sh",
    "preview": "vite preview",
    "types": "wrangler types",
    "icons": "node scripts/generate-icons.mjs",
    "fmt": "prettier --write '**/*.{ts,tsx,js,json,md}'",
    "fmt:check": "prettier --check '**/*.{ts,tsx,js,json,md}'",
    "prepare": "husky install",
    "docs:build": "echo 'Docs OK' && npm run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "oxlint"
    ],
    "*.md": "prettier --write"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.1",
    "idb": "^8.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-push-neo": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260624.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxlint": "^1.69.0",
    "prettier": "^3.9.1",
    "sharp": "^0.35.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.104.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "sharp@0.35.2": true,
    "workerd@1.20260623.1": true,
    "esbuild@0.28.1": true
  }
}
