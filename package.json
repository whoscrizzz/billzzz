{
  "name": "bills-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "dev:full": "npm run build && wrangler dev",
    "build": "tsc -b && vite build && node scripts/check-sw.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create bills-pwa-db",
    "db:migrate:local": "wrangler d1 migrations apply bills-pwa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bills-pwa-db --remote",
    "lint": "oxlint",
    "test": "node scripts/test-stats.mjs && node scripts/test-import.mjs",
    "preview": "vite preview",
    "types": "wrangler types",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-push-neo": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260624.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "sharp": "^0.35.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.104.0"
  }
}
